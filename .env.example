# API配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-ada-002

# 硅基流动 SiliconFlow API配置
SILICONFLOW_API_KEY=your_siliconflow_api_key_here_replace_with_real_key

# Pinecone配置（可选）
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=insurintellect-index

# 数据库配置
DATABASE_URL=sqlite:///./data/database/app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/insurintellect

# 向量数据库配置
VECTOR_DB_TYPE=chromadb  # chromadb 或 pinecone
CHROMA_PERSIST_DIRECTORY=./data/vector_db/chroma

# 文件存储配置
PDF_STORAGE_PATH=./data/documents/pdfs
PROCESSED_DATA_PATH=./data/processed

# 应用配置
APP_NAME=InsurIntellect Agent
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# 安全配置
SECRET_KEY=your_secret_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log

# 模型配置
MAX_TOKENS=2000
TEMPERATURE=0.7
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# 限流配置
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# OCR配置（Windows）
# 若安装在默认位置，可直接使用以下路径；如不同，请修改为实际安装路径
TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
# 默认识别语言：简体中文+英文。如需仅中文可设为 chi_sim
OCR_LANG=chi_sim+eng

# Chroma 遥测（建议关闭，避免代理环境下报错）
CHROMA_ANONYMIZED_TELEMETRY=false
CHROMA_DISABLE_TELEMETRY=1
