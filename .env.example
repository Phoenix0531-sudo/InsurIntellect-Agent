# Local demo / OpenAI-compatible provider (new-api or any OpenAI-style gateway)
# Copy this file to .env and fill OPENAI_API_KEY locally.
# Never commit real keys.

HOST=127.0.0.1
PORT=8766
DEBUG=true

# Preferred: local new-api or any OpenAI-compatible gateway
OPENAI_BASE_URL=http://127.0.0.1:31876/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_MODEL_CORE=gpt-5.4
OPENAI_MODEL_LIGHT=gpt-5.4
OPENAI_TIMEOUT_SECS=90

# Local embedding. First run may need network/proxy to fetch HF weights.
# Offline fallback: local:hash (weaker ranking). Keep ingest + query on the same model.
OPENAI_EMBEDDING_MODEL=hf:BAAI/bge-small-zh-v1.5
SIMILARITY_THRESHOLD=0.32

# Leave empty unless intentionally using SiliconFlow fallback
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_MODEL=

# Main-path defaults
SIMPLE_RAG_MODE=true
ENABLE_QUERY_REWRITING=false
ENABLE_QUERY_ROUTING=false
ENABLE_REGULATORY_RERANK=false
CONTEXT_BUILD_TIMEOUT_SECS=20
LLM_ANSWER_TIMEOUT_SECS=60
LLM_QUEUE_TIMEOUT_SECS=5

# Chroma / telemetry
CHROMA_ANONYMIZED_TELEMETRY=false
CHROMA_DISABLE_TELEMETRY=1
CHROMA_PERSIST_DIRECTORY=./data/vector_db/chroma
PROCESSED_DATA_PATH=./data/processed
PDF_STORAGE_PATH=./data/documents/pdfs

# Local SQLite. Leave DATABASE_URL_ASYNC empty unless you need async SQLAlchemy.
DATABASE_URL=sqlite:///./data/database/app.db
DATABASE_URL_ASYNC=
